{
  "manifest_version": 3,
  "name": "SceneForge · Kết nối phiên",
  "version": "1.7.1",
  "description": "Gửi prompt, ảnh tham khảo và nhận kết quả Gemini trực tiếp qua trình duyệt; giữ kết nối Flow.",
  "key": "",
  "permissions": [
    "cookies",
    "scripting",
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://google.com/*",
    "https://gemini.google.com/*",
    "https://labs.google/*",
    "https://flow.google.com/*",
    "http://127.0.0.1/*",
    "https://*.googleusercontent.com/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Kết nối SceneForge",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "sceneforge-local.js"
      ],
      "run_at": "document_start"
    }
  ]
}
