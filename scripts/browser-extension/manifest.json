{
  "manifest_version": 3,
  "name": "SceneForge · Kết nối phiên",
  "version": "1.4.0",
  "description": "Chuyển phiên Gemini/Flow sang SceneForge trên máy, chỉ khi bạn bấm Kết nối.",
  "key": "",
  "permissions": [
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://google.com/*",
    "https://gemini.google.com/*",
    "https://labs.google/*",
    "https://flow.google.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Kết nối SceneForge",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed"
}
